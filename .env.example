# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_NAME=NextGen BI
APP_ENV=development          # development | staging | production
APP_DEBUG=false              # em produção é bloqueado por validador (vaza SQL no log)
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
TZ=America/Sao_Paulo

# ─── Banco de metadados da plataforma ─────────────────────────────────────────
# Guarda tenants, usuários, conexões, dicionário e histórico de chat.
# NÃO é o banco do cliente — esse é cadastrado em runtime, por tenant.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nextgen_bi
DB_USER=nextgen              # em produção, nunca 'postgres' (validador bloqueia)
DB_PASSWORD=troque-me

# ─── Segredos ─────────────────────────────────────────────────────────────────
# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Criptografia das credenciais de banco dos clientes (Fernet, base64 de 32 bytes).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perder esta chave torna ilegível toda conexão já cadastrada. Guarde fora do servidor também.
CREDENTIALS_KEY=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# ─── Claude API ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo do Text-to-SQL. Precisão importa mais que custo nesta fase; o cache de
# prompt é que segura a conta (leitura de cache custa ~5% da entrada).
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high              # low | medium | high | xhigh | max

# ─── Limites de execução (o "não force bruta" em números) ────────────────────
# Teto de linhas estimadas pelo EXPLAIN. Acima disso a consulta é recusada com
# explicação, não executada.
MAX_ESTIMATED_ROWS=50000000
# Teto de custo estimado pelo planejador do Postgres.
MAX_ESTIMATED_COST=5000000
# Corta a consulta no banco do cliente, não no nosso processo.
QUERY_TIMEOUT_SECONDS=30
# LIMIT forçado em toda consulta que não tenha agregação.
MAX_RESULT_ROWS=10000
